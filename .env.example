# Copy to .env.local and fill in. Both values are PUBLIC BY DESIGN — the
# project URL and anon/publishable key ship in the browser bundle. Never put
# service_role or any other secret here; admin operations ride the admin-api
# Edge Function gateway instead (see AGENTS.md).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
